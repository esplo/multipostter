{
  "type": "module",
  "name": "multipostter",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24",
    "npm": "use-pnpm",
    "pnpm": ">=10"
  },
  "bin": {
    "multipostter": "bin/multipostter.js"
  },
  "scripts": {
    "build": "tsc",
    "format": "biome check --write bin lambda lib scripts --unsafe",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "watch": "tsc -w",
    "test": "tsc && node --test dist/lambda/client/*.test.js",
    "cdk": "cdk",
    "lambdabuild": "esbuild lambda/index.ts --bundle --minify --sourcemap --platform=node --target=es2024 --format=esm --outfile=dist/index.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/html-to-text": "^9.0.4",
    "@types/luxon": "^3.7.3",
    "@types/node": "26.1.2",
    "aws-cdk": "2.1135.0",
    "esbuild": "^0.28.1",
    "knip": "^6.31.0",
    "luxon": "^3.7.2",
    "npm-check-updates": "^23.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@atproto/api": "^0.20.37",
    "@aws-sdk/client-dynamodb": "^3.1102.0",
    "@aws-sdk/client-ssm": "^3.1102.0",
    "@aws-sdk/lib-dynamodb": "^3.1102.0",
    "aws-cdk-lib": "2.263.0",
    "axios": "^1.19.0",
    "constructs": "^10.8.1",
    "html-to-text": "^10.0.0",
    "masto": "^8.0.0",
    "sharp": "^0.35.3",
    "source-map-support": "^0.5.21",
    "twitter-api-v2": "^1.29.0"
  }
}
